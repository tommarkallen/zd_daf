// ---- ROCKS ----------------------------------------------------------------
// rocksdark1-4: four mesh shapes, skin ZKHXRK03 (dark stone, zoon_tex)
// rocksbrown1-4: skin SLROCK1 (aa_tex, brown earthy grain)
// rocksblack1-4: skin SLROCK22 (elementalism_tex, near-black obsidian)
// rocksgreen1-4: same meshes, skin ds_gras1 (darksouls_tex)

Model RocksDark1
{
	Model 0 "models/rocks1.md3"
	Scale 15 15 15
	DONTCULLBACKFACES
	USEACTORPITCH
	Skin 0 "textures/zoon_tex/ZKHXRK03.png"
	FrameIndex CDRA A 0 0
}

