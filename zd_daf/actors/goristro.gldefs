//===========================================================================
//
// GZDoom GLDefs - Goristro
//
//===========================================================================

PointLight GorisBall
{
    color 1.0 0.0 0.0
    size 64
}

FlickerLight GorisBall_X1
{
    color 1.0 0.0 0.0
    size 80
    secondarySize 88
    chance 0.25
}

FlickerLight GorisBall_X2
{
    color 0.4 0.0 0.0
    size 96
    secondarySize 104
    chance 0.25
}

FlickerLight GorisBall_X3
{
    color 0.2 0.0 0.0
    size 112
    secondarySize 120
    chance 0.25
}

Object GoristroBall
{
    Frame GORBA { light GorisBall    }
    Frame GORBB { light GorisBall    }
    Frame GORBC { light GorisBall_X1 }
    Frame GORBD { light GorisBall_X2 }
    Frame GORBE { light GorisBall_X3 }
}

