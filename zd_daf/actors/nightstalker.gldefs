//===========================================================================
//
// GZDoom GLDefs - Nightstalker
//
// Based on: "Obsidian Ravager" by DeVloek
//
//===========================================================================

Pulselight NightstalkerGlow
{
	color 0.4 0.0 0.0
	size 16
	secondarySize 20
	interval 2.0
	offset 0 64 0
}

Pulselight NightstalkerGlowLarge
{
	color 1.0 0.0 0.0
	size 16
	secondarySize 18
	interval 2.0
	offset 0 0 0
}

Pulselight NightstalkerGlowSmall
{
	color 1.0 0.0 0.0
	size 10
	secondarySize 12
	interval 2.0
	offset 0 0 0
}

object Nightstalker
{
	frame NSTL { light NightstalkerGlow }
}

object NightstalkerBall
{
	frame BAL7 { light NightstalkerGlowLarge }
}

object NightstalkerBarrage
{
	frame BAL7 { light NightstalkerGlowSmall }
}

