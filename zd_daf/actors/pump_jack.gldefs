// GLDEFS for PumpJack
// PBR materials: normal maps and shared specular map per surface.
// spec_thing.png is a shared specular map used across all 7 surfaces.

material texture "models/skins/pumpjack/walking_beam.png"
{
    normal "materials/normalmaps/walking_beam_norm.png"
    specular "materials/specularmaps/spec_thing.png"
    specularlevel 0.5
    glossiness 1.0
    disablefullbright
}

material texture "models/skins/pumpjack/main_body.png"
{
    normal "materials/normalmaps/main_body_norm.png"
    specular "materials/specularmaps/spec_thing.png"
    specularlevel 0.5
    glossiness 1.0
    disablefullbright
}

